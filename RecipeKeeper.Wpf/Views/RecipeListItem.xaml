<UserControl x:Class="RecipeKeeper.Wpf.Views.RecipeListItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CompactCard}" Padding="16,14" Margin="0,0,0,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="220" />
                <ColumnDefinition Width="132" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleTextBlock"
                           FontSize="17"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="DescriptionTextBlock"
                           Style="{StaticResource MutedText}"
                           Margin="0,4,0,8"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="40" />
                <WrapPanel>
                    <TextBlock x:Name="TimeTextBlock" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,12,0" />
                    <TextBlock x:Name="CategoryTextBlock" Foreground="{StaticResource MutedTextBrush}" />
                </WrapPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button Content="Открыть"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="112"
                        Padding="10,7"
                        Click="OpenButton_Click" />
                <Button x:Name="SecondaryButton"
                        Content="В избранное"
                        MinWidth="112"
                        Padding="10,7"
                        Click="SecondaryButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="RecipeKeeper.Wpf.Views.RecipeListItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             SizeChanged="RecipeListItem_SizeChanged">
    <Border Style="{StaticResource RecipeCard}"
            HorizontalAlignment="Stretch">
        <Grid x:Name="MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ImageColumn" Width="252" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ActionColumn" Width="210" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ImageBorder"
                    Width="232"
                    Height="128"
                    CornerRadius="12"
                    Background="{StaticResource SecondaryButtonBrush}"
                    ClipToBounds="True"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left">
                <Image x:Name="RecipeImage"
                       Stretch="UniformToFill"
                       SnapsToDevicePixels="True" />
            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0">
                <TextBlock x:Name="TitleTextBlock"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="DescriptionTextBlock"
                           Style="{StaticResource MutedText}"
                           FontSize="14"
                           Margin="0,6,0,12"
                           TextWrapping="Wrap"
                           MaxHeight="42" />
                <WrapPanel>
                    <Border Style="{StaticResource StatusBadge}"
                            Background="{StaticResource SecondaryButtonBrush}"
                            Margin="0,0,8,0">
                        <TextBlock x:Name="TimeTextBlock"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                    </Border>
                    <Border Style="{StaticResource StatusBadge}"
                            Background="{StaticResource AccentLightBrush}">
                        <TextBlock x:Name="CategoryTextBlock"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                    </Border>
                </WrapPanel>
            </StackPanel>

            <StackPanel x:Name="ActionPanel"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Width="200">
                <Button Content="Открыть"
                        Style="{StaticResource PrimaryButton}"
                        MinHeight="42"
                        Padding="12,7"
                        Margin="0,0,0,8"
                        Click="OpenButton_Click" />
                <Button x:Name="SecondaryButton"
                        Content="В избранное"
                        Style="{StaticResource SecondaryButton}"
                        MinHeight="42"
                        Padding="12,7"
                        Margin="0"
                        Click="SecondaryButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="RecipeKeeper.Wpf.Views.RecipeListItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch">
    <Border Style="{StaticResource RecipeCard}"
            Padding="14"
            Margin="0,0,0,12"
            HorizontalAlignment="Stretch">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="126"
                    Height="88"
                    CornerRadius="10"
                    Background="#F0ECE3"
                    ClipToBounds="True"
                    VerticalAlignment="Top">
                <Image x:Name="RecipeImage"
                       Stretch="UniformToFill"
                       SnapsToDevicePixels="True" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock x:Name="TitleTextBlock"
                           FontSize="17"
                           FontWeight="Bold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="DescriptionTextBlock"
                           Style="{StaticResource MutedText}"
                           Margin="0,4,0,8"
                           TextWrapping="Wrap"
                           MaxHeight="42" />
                <WrapPanel>
                    <Border Style="{StaticResource StatusBadge}" Background="#F2EEE6" Margin="0,0,8,0">
                        <TextBlock x:Name="TimeTextBlock" Foreground="#3F4741" />
                    </Border>
                    <Border Style="{StaticResource StatusBadge}" Background="#EAF3EC">
                        <TextBlock x:Name="CategoryTextBlock" Foreground="{StaticResource AccentDarkBrush}" />
                    </Border>
                </WrapPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="132">
                <Button Content="Открыть"
                        Style="{StaticResource PrimaryButton}"
                        Padding="10,7"
                        Click="OpenButton_Click" />
                <Button x:Name="SecondaryButton"
                        Content="В избранное"
                        Padding="10,7"
                        Click="SecondaryButton_Click" />
            </StackPanel>
        </Grid>
</Border>
</UserControl>

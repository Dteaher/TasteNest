<UserControl x:Class="RecipeKeeper.Wpf.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Статистика" Style="{StaticResource PageTitle}" Margin="0,0,0,4" />
        <TextBlock Text="Обзор рецептов, продуктов, избранного и активности в TasteNest."
                   Style="{StaticResource MutedText}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16" />

        <UniformGrid Columns="4" Margin="0,0,0,16">
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Рецепты" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="RecipesCountText" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentDarkBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Избранное" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="FavoritesCountText" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentDarkBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Продукты" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="ProductsCountText" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentDarkBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Приготовлено" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="CookCountText" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentDarkBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource ResponsiveCard}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Популярные категории" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Какие типы блюд чаще всего встречаются в базе."
                               Style="{StaticResource MutedText}"
                               Margin="0,0,0,14" />
                    <ItemsControl x:Name="CategoryItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Count}" Style="{StaticResource MutedText}" />
                                    <ProgressBar Grid.Row="1"
                                                 Grid.ColumnSpan="2"
                                                 Style="{StaticResource ProgressBarStat}"
                                                 Maximum="100"
                                                 Value="{Binding Percent}"
                                                 Margin="0,7,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource ResponsiveCard}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Частые ингредиенты" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Ингредиенты, которые чаще всего встречаются в рецептах."
                               Style="{StaticResource MutedText}"
                               Margin="0,0,0,14" />
                    <ItemsControl x:Name="IngredientItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F7F5ED"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,8"
                                        Margin="0,0,8,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <Border Grid.Column="1" Style="{StaticResource StatusBadge}" Background="#EAF3EC" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Count}" Foreground="{StaticResource AccentDarkBrush}" FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource ResponsiveCard}" Padding="20" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Активность рецептов" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Приготовления и рейтинг помогают понять, какие блюда стоит показывать выше."
                           Style="{StaticResource MutedText}"
                           Margin="0,0,0,14" />
                <ItemsControl x:Name="PopularityItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="{Binding CookText}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="{Binding RatingText}" Foreground="{StaticResource AccentDarkBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

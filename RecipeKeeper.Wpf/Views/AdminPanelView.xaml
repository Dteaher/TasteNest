<UserControl x:Class="RecipeKeeper.Wpf.Views.AdminPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource PageScrollViewer}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource PageCard}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Центр управления TasteNest" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Администратор управляет пользователями, ролями, сервером и публикацией пользовательских рецептов."
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="#E9F3ED" CornerRadius="14" Padding="16,10" VerticalAlignment="Center">
                        <TextBlock Text="Admin · полный доступ" Foreground="{StaticResource AccentDarkBrush}" FontWeight="Bold" />
                    </Border>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="Пользователи" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="TotalUsersText" FontSize="26" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="Роли" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="RolesSummaryText" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="Контент" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="ContentSummaryText" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="На модерации" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="PendingRecipesCountText" FontSize="26" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="520" />
                    <ColumnDefinition Width="340" MinWidth="310" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource PageCard}" Margin="0,0,18,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="Пользователи" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Роли выдаёт только администратор. Главный администратор защищён от блокировки и смены роли."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <DataGrid x:Name="UsersGrid"
                                  Style="{StaticResource StyledDataGrid}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MinHeight="380"
                                  SelectionChanged="UsersGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55" />
                                <DataGridTextColumn Header="Пользователь" Binding="{Binding Email}" Width="2*" MinWidth="170" />
                                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="*" MinWidth="95" />
                                <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="90" />
                                <DataGridTextColumn Header="Рецепты" Binding="{Binding RecipesCount}" Width="90" />
                                <DataGridTextColumn Header="Избранное" Binding="{Binding FavoritesCount}" Width="100" />
                                <DataGridTextColumn Header="Просмотры" Binding="{Binding ViewsCount}" Width="100" />
                                <DataGridTextColumn Header="Продукты" Binding="{Binding ProductsCount}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource PageCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Действия с пользователем" Style="{StaticResource PageTitle}" />
                            <Border Background="#F7F5ED" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock x:Name="SelectedUserNameText" Text="Пользователь не выбран" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="SelectedUserRoleText" Text="Выберите строку в таблице" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Назначить роль" Style="{StaticResource LabelText}" />
                            <ComboBox x:Name="RoleComboBox" />
                            <Button Content="Сохранить роль" Style="{StaticResource PrimaryButton}" Click="ApplyRole_Click" />
                            <Button x:Name="ToggleStatusButton" Content="Заблокировать / разблокировать" Click="ToggleStatus_Click" />
                            <Button Content="Обновить список" Click="RefreshButton_Click" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PageCard}">
                        <StackPanel>
                            <TextBlock Text="SQL Server" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="Управление службой SQL Server Express на этом компьютере."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,12" />

                            <Border Background="#F7F5ED" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Статус службы" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="ServerStatusText" FontSize="20" FontWeight="Bold" />
                                </StackPanel>
                            </Border>

                            <Button Content="Обновить статус" Click="RefreshServerStatus_Click" />
                            <Button Content="Включить сервер" Style="{StaticResource PrimaryButton}" Click="StartServer_Click" />
                            <Button Content="Выключить сервер" Style="{StaticResource DangerButton}" Click="StopServer_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource PageCard}" Margin="0,0,0,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Модерация рецептов" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Рецепты, созданные пользователями, появляются здесь. После публикации они становятся видны всем в поиске."
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="PendingRecipesPanel" />
                </DockPanel>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource PageCard}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Все рецепты" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Здесь администратор может удалить лишний, ошибочный или устаревший рецепт."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Обновить" Click="RefreshRecipesButton_Click" Margin="0,0,10,0" />
                            <Button x:Name="DeleteSelectedRecipeButton"
                                    Content="Удалить выбранный рецепт"
                                    Style="{StaticResource DangerButton}"
                                    IsEnabled="False"
                                    Click="DeleteSelectedRecipe_Click" />
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="AdminRecipesGrid"
                              Style="{StaticResource StyledDataGrid}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MinHeight="320"
                              SelectionChanged="AdminRecipesGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55" />
                            <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*" MinWidth="220" />
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="*" MinWidth="140" />
                            <DataGridTextColumn Header="Автор" Binding="{Binding AuthorEmail}" Width="*" MinWidth="170" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120" />
                            <DataGridTextColumn Header="Создан" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <TextBlock Grid.Row="5"
                       x:Name="StatusTextBlock"
                       Style="{StaticResource MutedText}"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap" />
        </Grid>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="RecipeKeeper.Wpf.Views.AdminPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource PageScrollViewer}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource PageCard}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Центр управления TasteNest" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Администратор управляет ролями, доступом и общей структурой системы."
                                   Style="{StaticResource MutedText}" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="#E9F3ED" CornerRadius="14" Padding="16,10" VerticalAlignment="Center">
                        <TextBlock Text="Admin · полный доступ" Foreground="{StaticResource AccentDarkBrush}" FontWeight="Bold" />
                    </Border>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="Пользователи" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="TotalUsersText" FontSize="26" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="Роли" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="RolesSummaryText" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="Контент" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="ContentSummaryText" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="Заблокированы" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="BlockedUsersText" FontSize="26" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="520" />
                    <ColumnDefinition Width="320" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource PageCard}" Margin="0,0,18,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="Реестр пользователей" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Полный список аккаунтов. Только администратор может менять роли."
                                       Style="{StaticResource MutedText}" />
                        </StackPanel>

                        <DataGrid x:Name="UsersGrid"
                                  Style="{StaticResource StyledDataGrid}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MinHeight="440"
                                  SelectionChanged="UsersGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                                <DataGridTextColumn Header="Пользователь" Binding="{Binding Email}" Width="2*" MinWidth="180" />
                                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="*" MinWidth="100" />
                                <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="90" />
                                <DataGridTextColumn Header="Рецепты" Binding="{Binding RecipesCount}" Width="*" MinWidth="82" />
                                <DataGridTextColumn Header="Избранное" Binding="{Binding FavoritesCount}" Width="*" MinWidth="96" />
                                <DataGridTextColumn Header="Просмотры" Binding="{Binding ViewsCount}" Width="*" MinWidth="96" />
                                <DataGridTextColumn Header="Продукты" Binding="{Binding ProductsCount}" Width="*" MinWidth="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource PageCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Общая статистика" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="Сводка по всему TasteNest для администратора."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,14" />

                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource SummaryCard}">
                                    <StackPanel>
                                        <TextBlock Text="Рецепты" Style="{StaticResource MutedText}" />
                                        <TextBlock x:Name="GlobalRecipesText" FontSize="24" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SummaryCard}">
                                    <StackPanel>
                                        <TextBlock Text="Продукты" Style="{StaticResource MutedText}" />
                                        <TextBlock x:Name="GlobalProductsText" FontSize="24" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SummaryCard}">
                                    <StackPanel>
                                        <TextBlock Text="Просмотры" Style="{StaticResource MutedText}" />
                                        <TextBlock x:Name="GlobalViewsText" FontSize="24" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SummaryCard}">
                                    <StackPanel>
                                        <TextBlock Text="Приготовлено" Style="{StaticResource MutedText}" />
                                        <TextBlock x:Name="GlobalCookText" FontSize="24" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PageCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Управление ролью" Style="{StaticResource PageTitle}" />
                            <Border Background="#F7F5ED" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock x:Name="SelectedUserNameText" Text="Пользователь не выбран" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="SelectedUserRoleText" Text="Выберите строку в таблице" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Новая роль" Style="{StaticResource LabelText}" />
                            <ComboBox x:Name="RoleComboBox" />
                            <Button Content="Сохранить роль" Style="{StaticResource PrimaryButton}" Click="ApplyRole_Click" />
                            <Button x:Name="ToggleStatusButton" Content="Блокировка аккаунта" Click="ToggleStatus_Click" />
                            <Button Content="Обновить реестр" Click="RefreshButton_Click" />

                            <TextBlock x:Name="StatusTextBlock" Style="{StaticResource MutedText}" Margin="0,12,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PageCard}">
                        <StackPanel>
                            <TextBlock Text="Правила администратора" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="Admin в системе один: admin/admin. Его нельзя заблокировать, удалить или понизить."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="Админ назначает только User или Operator, чтобы структура ролей оставалась понятной для защиты проекта."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PageCard}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Сервер SQL" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="Управление службой SQL Server Express на этом компьютере."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,12" />

                            <Border Background="#F7F5ED" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Статус службы" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="ServerStatusText" FontSize="20" FontWeight="Bold" />
                                </StackPanel>
                            </Border>

                            <Button Content="Обновить статус" Click="RefreshServerStatus_Click" />
                            <Button Content="Включить сервер" Style="{StaticResource PrimaryButton}" Click="StartServer_Click" />
                            <Button Content="Выключить сервер" Style="{StaticResource DangerButton}" Click="StopServer_Click" />

                            <TextBlock Text="При запуске и остановке Windows может запросить права администратора."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>


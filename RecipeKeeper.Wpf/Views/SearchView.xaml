<UserControl x:Class="RecipeKeeper.Wpf.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="SearchView_SizeChanged">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="FilterRow" Height="*" />
            <RowDefinition x:Name="GapRow" Height="0" />
            <RowDefinition x:Name="ResultsRow" Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="FilterColumn" Width="292" />
            <ColumnDefinition x:Name="GapColumn" Width="16" />
            <ColumnDefinition x:Name="ResultsColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="FilterCard" Style="{StaticResource ResponsiveCard}" Padding="18">
            <StackPanel>
                <TextBlock Text="Фильтры" Style="{StaticResource PageTitle}" />

                <TextBlock Text="Поиск по названию" Style="{StaticResource LabelText}" />
                <TextBox x:Name="SearchTextBox" Style="{StaticResource AppTextBox}" />

                <TextBlock Text="Категория" Style="{StaticResource LabelText}" />
                <ComboBox x:Name="CategoryComboBox" Style="{StaticResource AppComboBox}" DisplayMemberPath="Name" />

                <TextBlock Text="Теги" Style="{StaticResource LabelText}" />
                <TextBox x:Name="TagsTextBox" Style="{StaticResource AppTextBox}" />

                <Button Content="Показать" Style="{StaticResource PrimaryButton}" Click="ShowButton_Click" Margin="0,8,0,4" />
                <Button Content="Очистить" Click="ClearButton_Click" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border x:Name="ResultsCard" Grid.Column="2" Style="{StaticResource ResponsiveCard}" Padding="18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Найденные рецепты" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="ResultCountTextBlock"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              PanningMode="VerticalOnly">
                    <StackPanel x:Name="RecipesPanel" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="RecipeKeeper.Wpf.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RecipeKeeper.Wpf.Ui"
             SizeChanged="SearchView_SizeChanged"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="FilterGroup" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style x:Key="FilterLabel" TargetType="TextBlock" BasedOn="{StaticResource TasteNestFieldLabelStyle}" />

        <Style x:Key="FilterTextBox" TargetType="TextBox" BasedOn="{StaticResource TasteNestTextBoxStyle}">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="FilterComboBox" TargetType="ComboBox" BasedOn="{StaticResource TasteNestComboBoxStyle}">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="ViewToggleButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="{StaticResource SecondaryButtonBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentLightBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScrollViewer}">
        <Grid x:Name="RootGrid"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="FilterRow" Height="*" />
                <RowDefinition x:Name="GapRow" Height="0" />
                <RowDefinition x:Name="ResultsRow" Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FilterColumn" Width="320" />
                <ColumnDefinition x:Name="GapColumn" Width="22" />
                <ColumnDefinition x:Name="ResultsColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="FilterCard"
                    Style="{StaticResource ResponsiveCard}"
                    Padding="24"
                    CornerRadius="18"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <DockPanel Margin="0,0,0,20">
                            <TextBlock Text="&#x1F343;"
                                       DockPanel.Dock="Right"
                                       FontSize="22"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Фильтры"
                                       Style="{StaticResource PageTitle}"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <StackPanel Style="{StaticResource FilterGroup}">
                            <TextBlock Text="Поиск по названию" Style="{StaticResource FilterLabel}" />
                            <TextBox x:Name="SearchTextBox"
                                     Style="{StaticResource FilterTextBox}"
                                     Tag="Введите название рецепта..."
                                     TextChanged="FilterInput_Changed" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource FilterGroup}">
                            <TextBlock Text="Категория" Style="{StaticResource FilterLabel}" />
                            <ComboBox x:Name="CategoryComboBox"
                                      Style="{StaticResource FilterComboBox}"
                                      SelectionChanged="FilterInput_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Style="{StaticResource FilterGroup}">
                            <TextBlock Text="Ингредиенты" Style="{StaticResource FilterLabel}" />
                            <TextBox x:Name="TagsTextBox"
                                     Style="{StaticResource FilterTextBox}"
                                     Tag="Введите ингредиент..."
                                     TextChanged="FilterInput_Changed" />
                            <TextBlock Text="Например: курица, рис, томаты"
                                       Style="{StaticResource MutedText}"
                                       FontSize="13"
                                       Margin="0,8,0,0" />
                        </StackPanel>

                        <Button Content="Показать рецепты"
                                Style="{StaticResource PrimaryButton}"
                                Click="ShowButton_Click"
                                HorizontalAlignment="Stretch"
                                MinHeight="48"
                                Margin="0,2,0,10" />
                        <Button Content="Очистить фильтры"
                                Style="{StaticResource SecondaryButton}"
                                Click="ClearButton_Click"
                                HorizontalAlignment="Stretch"
                                MinHeight="46"
                                Margin="0" />
                    </StackPanel>

                </Grid>
            </Border>

            <Border x:Name="ResultsCard"
                    Grid.Column="2"
                    Style="{StaticResource ResponsiveCard}"
                    Padding="22"
                    CornerRadius="18"
                    VerticalAlignment="Stretch">
                <DockPanel LastChildFill="True">
                    <Grid x:Name="ResultsHeaderGrid" DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Найденные рецепты"
                                       Style="{StaticResource PageTitle}"
                                       Margin="0,0,12,0" />
                            <Border Style="{StaticResource StatusBadge}"
                                    Background="{StaticResource AccentLightBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="ResultCountTextBlock"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <WrapPanel x:Name="ResultsActionsPanel"
                                   Grid.Column="1"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center">
                            <Button x:Name="GridViewButton"
                                    Content="&#x25A6;"
                                    Style="{StaticResource ViewToggleButton}"
                                    ToolTip="Плитка"
                                    Click="GridViewButton_Click" />
                            <Button x:Name="ListViewButton"
                                    Content="&#x2630;"
                                    Style="{StaticResource ViewToggleButton}"
                                    ToolTip="Список"
                                    Click="ListViewButton_Click" />
                            <ComboBox x:Name="SortComboBox"
                                      Style="{StaticResource TasteNestComboBoxStyle}"
                                      Width="178"
                                      Height="40"
                                      MinHeight="40"
                                      Margin="0,0,8,0"
                                      Padding="12,0"
                                      SelectionChanged="SortComboBox_SelectionChanged"
                                      ToolTip="Сортировка" />
                            <Button Content="+ Добавить рецепт"
                                    Style="{StaticResource PrimaryButton}"
                                    MinHeight="40"
                                    Padding="14,7"
                                    Margin="0"
                                    Click="AddRecipeButton_Click" />
                        </WrapPanel>
                    </Grid>

                    <Grid>
                        <StackPanel x:Name="RecipesPanel"
                                    HorizontalAlignment="Stretch" />
                        <WrapPanel x:Name="RecipesGridPanel"
                                   Visibility="Collapsed"
                                   HorizontalAlignment="Stretch"
                                   ItemWidth="320" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

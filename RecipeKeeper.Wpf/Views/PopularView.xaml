<UserControl x:Class="RecipeKeeper.Wpf.Views.PopularView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RecipeKeeper.Wpf.Ui">
    <Border Style="{StaticResource PageCard}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Популярные рецепты" Style="{StaticResource PageTitle}" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly"
                          ui:MouseWheelScroll.ForwardNestedWheel="True">
                <StackPanel x:Name="RecipesPanel" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>

<UserControl x:Class="RecipeKeeper.Wpf.Views.AddRecipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RecipeKeeper.Wpf.Ui">
    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly"
                  ui:MouseWheelScroll.ForwardNestedWheel="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource PageCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Добавить рецепт" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Новые рецепты пользователей отправляются администратору на проверку. После публикации рецепт будет виден всем пользователям в поиске."
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource PageCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Название" Style="{StaticResource LabelText}" />
                    <TextBox x:Name="TitleTextBox" Grid.Row="0" Grid.Column="1" />

                    <TextBlock Grid.Row="1" Text="Категория" Style="{StaticResource LabelText}" />
                    <ComboBox x:Name="CategoryComboBox" Grid.Row="1" Grid.Column="1" DisplayMemberPath="Name" />

                    <TextBlock Grid.Row="2" Text="Описание" Style="{StaticResource LabelText}" />
                    <TextBox x:Name="DescriptionTextBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Height="86"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                    <TextBlock Grid.Row="3" Text="Параметры" Style="{StaticResource LabelText}" />
                    <WrapPanel Grid.Row="3" Grid.Column="1">
                        <TextBox x:Name="TimeTextBox" Width="130" Text="30" ToolTip="Время приготовления, мин" />
                        <TextBox x:Name="ServingsTextBox" Width="130" Text="2" ToolTip="Количество порций" />
                        <ComboBox x:Name="DifficultyComboBox" Width="170" />
                    </WrapPanel>

                    <TextBlock Grid.Row="4" Text="Фото / путь" Style="{StaticResource LabelText}" />
                    <TextBox x:Name="ImageTextBox"
                             Grid.Row="4"
                             Grid.Column="1"
                             ToolTip="Можно оставить пустым. Тогда будет использована заглушка." />

                    <TextBlock Grid.Row="5" Text="Ингредиенты" Style="{StaticResource LabelText}" />
                    <TextBox x:Name="IngredientsTextBox"
                             Grid.Row="5"
                             Grid.Column="1"
                             Height="135"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Text="картофель - 800 г&#x0a;курица - 500 г" />

                    <TextBlock Grid.Row="6" Text="Шаги" Style="{StaticResource LabelText}" />
                    <TextBox x:Name="InstructionsTextBox"
                             Grid.Row="6"
                             Grid.Column="1"
                             Height="155"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                    <Grid Grid.Row="7" Grid.Column="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Отправить на проверку"
                                Style="{StaticResource PrimaryButton}"
                                Click="SaveButton_Click" />
                        <Button Grid.Column="1"
                                Content="Очистить"
                                Style="{StaticResource SecondaryButton}"
                                Click="ClearButton_Click" />
                        <TextBlock Grid.Column="2"
                                   x:Name="StatusTextBlock"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

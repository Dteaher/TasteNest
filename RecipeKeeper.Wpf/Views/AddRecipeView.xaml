<UserControl x:Class="RecipeKeeper.Wpf.Views.AddRecipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RecipeKeeper.Wpf.Ui">
    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly"
                  ui:MouseWheelScroll.ForwardNestedWheel="True">
        <Border Style="{StaticResource PageCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.ColumnSpan="2" Text="Добавить рецепт" Style="{StaticResource PageTitle}" />
                <TextBlock Grid.Row="1" Text="Название" Style="{StaticResource LabelText}" />
                <TextBox x:Name="TitleTextBox" Grid.Row="1" Grid.Column="1" />
                <TextBlock Grid.Row="2" Text="Категория" Style="{StaticResource LabelText}" />
                <ComboBox x:Name="CategoryComboBox" Grid.Row="2" Grid.Column="1" DisplayMemberPath="Name" />
                <TextBlock Grid.Row="3" Text="Описание" Style="{StaticResource LabelText}" />
                <TextBox x:Name="DescriptionTextBox" Grid.Row="3" Grid.Column="1" Height="80" AcceptsReturn="True" TextWrapping="Wrap" />
                <TextBlock Grid.Row="4" Text="Параметры" Style="{StaticResource LabelText}" />
                <WrapPanel Grid.Row="4" Grid.Column="1">
                    <TextBox x:Name="TimeTextBox" Width="130" Text="30" ToolTip="Время" />
                    <TextBox x:Name="ServingsTextBox" Width="130" Text="2" ToolTip="Порции" />
                    <ComboBox x:Name="DifficultyComboBox" Width="160" />
                </WrapPanel>
                <TextBlock Grid.Row="5" Text="Фото URL" Style="{StaticResource LabelText}" />
                <TextBox x:Name="ImageTextBox" Grid.Row="5" Grid.Column="1" />
                <TextBlock Grid.Row="6" Text="Ингредиенты" Style="{StaticResource LabelText}" />
                <TextBox x:Name="IngredientsTextBox" Grid.Row="6" Grid.Column="1" Height="130" AcceptsReturn="True" TextWrapping="Wrap" Text="банан - 1 шт.&#x0a;мука - 150 г" />
                <TextBlock Grid.Row="7" Text="Шаги" Style="{StaticResource LabelText}" />
                <TextBox x:Name="InstructionsTextBox" Grid.Row="7" Grid.Column="1" Height="150" AcceptsReturn="True" TextWrapping="Wrap" />
                <Grid Grid.Row="8" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Сохранить рецепт" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" />
                    <Button Grid.Column="1" Content="Очистить" Style="{StaticResource SecondaryButton}" Click="ClearButton_Click" />
                    <TextBlock Grid.Column="2" x:Name="StatusTextBlock" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="RecipeKeeper.Wpf.Views.AddRecipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RecipeKeeper.Wpf.Ui">
    <UserControl.Resources>
        <Style x:Key="FormSection" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly"
                  ui:MouseWheelScroll.ForwardNestedWheel="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource PageCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Добавить рецепт" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Новые рецепты пользователей отправляются администратору на проверку. После публикации рецепт будет виден всем пользователям в поиске."
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource PageCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource FormSection}">
                        <TextBlock Text="Название" Style="{StaticResource LabelText}" />
                        <TextBox x:Name="TitleTextBox"
                                 HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Left"
                                 TextAlignment="Left" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource FormSection}">
                        <TextBlock Text="Категория" Style="{StaticResource LabelText}" />
                        <ComboBox x:Name="CategoryComboBox"
                                  DisplayMemberPath="Name"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource FormSection}">
                        <TextBlock Text="Описание" Style="{StaticResource LabelText}" />
                        <TextBox x:Name="DescriptionTextBox"
                                 Style="{StaticResource TasteNestMultilineTextBoxStyle}"
                                 MinHeight="86"
                                 HorizontalAlignment="Stretch"
                                 TextAlignment="Left"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource FormSection}">
                        <TextBlock Text="Параметры" Style="{StaticResource LabelText}" />
                        <WrapPanel>
                            <TextBox x:Name="TimeTextBox"
                                     Width="130"
                                     Text="30"
                                     HorizontalContentAlignment="Left"
                                     TextAlignment="Left"
                                     ToolTip="Время приготовления, мин" />
                            <TextBox x:Name="ServingsTextBox"
                                     Width="130"
                                     Text="2"
                                     HorizontalContentAlignment="Left"
                                     TextAlignment="Left"
                                     ToolTip="Количество порций" />
                            <ComboBox x:Name="DifficultyComboBox"
                                      Width="170"
                                      HorizontalContentAlignment="Left" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Style="{StaticResource FormSection}">
                        <TextBlock Text="Фото / путь" Style="{StaticResource LabelText}" />
                        <TextBox x:Name="ImageTextBox"
                                 HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Left"
                                 TextAlignment="Left"
                                 ToolTip="Можно оставить пустым. Тогда будет использована заглушка." />
                    </StackPanel>

                    <StackPanel Style="{StaticResource FormSection}">
                        <TextBlock Text="Ингредиенты" Style="{StaticResource LabelText}" />
                        <TextBox x:Name="IngredientsTextBox"
                                 Style="{StaticResource TasteNestMultilineTextBoxStyle}"
                                 MinHeight="135"
                                 HorizontalAlignment="Stretch"
                                 TextAlignment="Left"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Text="картофель - 800 г&#x0a;курица - 500 г" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource FormSection}">
                        <TextBlock Text="Шаги" Style="{StaticResource LabelText}" />
                        <TextBox x:Name="InstructionsTextBox"
                                 Style="{StaticResource TasteNestMultilineTextBoxStyle}"
                                 MinHeight="155"
                                 HorizontalAlignment="Stretch"
                                 TextAlignment="Left"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </StackPanel>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Отправить на проверку"
                                Style="{StaticResource PrimaryButton}"
                                Click="SaveButton_Click" />
                        <Button Grid.Column="1"
                                Content="Очистить"
                                Style="{StaticResource SecondaryButton}"
                                Click="ClearButton_Click" />
                        <TextBlock Grid.Column="2"
                                   x:Name="StatusTextBlock"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="RecipeKeeper.Wpf.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RecipeKeeper.Wpf.Ui">
    <UserControl.Resources>
        <Style x:Key="ActivityListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource AccentLightBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource AccentLightBrush}" />
                                <Setter TargetName="ItemRoot" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScrollViewer}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PageCard}" Margin="0,0,16,0">
                <StackPanel>
                    <Border Width="78" Height="78" CornerRadius="18" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" Margin="0,0,0,16">
                        <TextBlock Text="TN" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="Профиль" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="UserTextBlock" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock x:Name="RoleTextBlock" Style="{StaticResource MutedText}" Margin="0,4,0,18" />

                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="Рецепты" Style="{StaticResource MutedText}" />
                                <TextBlock x:Name="RecipesCountText" FontSize="24" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="Избранное" Style="{StaticResource MutedText}" />
                                <TextBlock x:Name="FavoritesCountText" FontSize="24" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="Просмотры" Style="{StaticResource MutedText}" />
                                <TextBlock x:Name="ViewsCountText" FontSize="24" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="Продукты" Style="{StaticResource MutedText}" />
                                <TextBlock x:Name="ProductsCountText" FontSize="24" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Background="#F7F5ED" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Публикация рецептов" FontWeight="Bold" />
                            <TextBlock Text="Созданные рецепты сначала проходят проверку администратора. После публикации они появляются в общем поиске."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource PageCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Быстрый доступ" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Основные разделы аккаунта без лишнего дублирования экранов."
                                   Style="{StaticResource MutedText}"
                                   Margin="0,0,0,14"
                                   TextWrapping="Wrap" />

                        <UniformGrid Columns="3">
                            <Button Style="{StaticResource QuickActionButton}" Tag="Favorites" Click="InsightNavigate_Click" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Избранное" FontWeight="Bold" FontSize="17" />
                                    <TextBlock Text="Открыть сохранённые рецепты." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickActionButton}" Tag="MealPlan" Click="InsightNavigate_Click" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="План питания" FontWeight="Bold" FontSize="17" />
                                    <TextBlock Text="Меню на неделю и блюда по дням." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickActionButton}" Tag="Stats" Click="InsightNavigate_Click">
                                <StackPanel>
                                    <TextBlock Text="Статистика" FontWeight="Bold" FontSize="17" />
                                    <TextBlock Text="Итоги по рецептам и активности." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PageCard}" Margin="0,0,0,16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="Мои рецепты" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Здесь видно, какие рецепты опубликованы, ожидают проверки или были отклонены."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel x:Name="MyRecipesPanel" />
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource PageCard}" Padding="0">
                    <Expander x:Name="ActivityExpander"
                              IsExpanded="True"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0">
                        <Expander.Header>
                            <Grid Margin="20,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Последняя активность"
                                               Style="{StaticResource PageTitle}"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="Недавно открытые рецепты. Нажмите на блюдо, чтобы открыть карточку."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Style="{StaticResource StatusBadge}"
                                        Background="{StaticResource AccentLightBrush}"
                                        VerticalAlignment="Center"
                                        Margin="16,0,0,0">
                                    <TextBlock x:Name="ActivityCountText"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Expander.Header>

                        <Border BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="0,1,0,0"
                                Padding="20,0,20,20">
                            <ListBox x:Name="HistoryListBox"
                                     MaxHeight="280"
                                     Margin="0,18,0,0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Cursor="Hand"
                                     SelectionChanged="HistoryListBox_SelectionChanged"
                                     ItemContainerStyle="{StaticResource ActivityListItem}"
                                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="False"
                                     ui:MouseWheelScroll.ForwardNestedWheel="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="30"
                                                    Height="30"
                                                    CornerRadius="10"
                                                    Background="{StaticResource SecondaryButtonBrush}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="↗"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ViewedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="13"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Expander>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

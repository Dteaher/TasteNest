<UserControl x:Class="RecipeKeeper.Wpf.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource PageScrollViewer}">
        <Grid MinWidth="720">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PageCard}" Margin="0,0,16,0">
                <StackPanel>
                    <Border Width="78" Height="78" CornerRadius="18" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" Margin="0,0,0,16">
                        <TextBlock Text="TN" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Профиль" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="UserTextBlock" FontSize="18" FontWeight="Bold" />
                    <TextBlock x:Name="RoleTextBlock" Style="{StaticResource MutedText}" Margin="0,4,0,18" />
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="Рецепты" Style="{StaticResource MutedText}" />
                                <TextBlock x:Name="RecipesCountText" FontSize="24" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="Избранное" Style="{StaticResource MutedText}" />
                                <TextBlock x:Name="FavoritesCountText" FontSize="24" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="Просмотры" Style="{StaticResource MutedText}" />
                                <TextBlock x:Name="ViewsCountText" FontSize="24" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="Продукты" Style="{StaticResource MutedText}" />
                                <TextBlock x:Name="ProductsCountText" FontSize="24" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Background="#F7F5ED" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Подсказка" FontWeight="Bold" />
                            <TextBlock Text="Добавляйте продукты и отмечайте избранные блюда — профиль будет подсказывать, что приготовить и что докупить." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="1" Style="{StaticResource PageCard}" Margin="0,0,0,16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Последняя активность" Style="{StaticResource PageTitle}" />
                        <ListBox x:Name="HistoryListBox" MinHeight="170">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding ViewedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Row="0" Style="{StaticResource PageCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Разделы профиля" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Быстрый доступ к личным разделам без дублирования их содержимого на странице." Style="{StaticResource MutedText}" Margin="0,0,0,14" />

                        <UniformGrid Columns="3">
                            <Button Style="{StaticResource QuickActionButton}" Tag="Favorites" Click="InsightNavigate_Click" Margin="0,0,12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="#E4F1E7" VerticalAlignment="Top">
                                        <TextBlock Text="★" Foreground="{StaticResource AccentDarkBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Избранное" FontWeight="Bold" FontSize="17" />
                                        <TextBlock Text="Сохранённые рецепты и быстрый возврат к ним." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource QuickActionButton}" Tag="MealPlan" Click="InsightNavigate_Click" Margin="0,0,12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="#EAF3EF" VerticalAlignment="Top">
                                        <TextBlock Text="7" Foreground="{StaticResource AccentDarkBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="План питания" FontWeight="Bold" FontSize="17" />
                                        <TextBlock Text="Меню на неделю, блюда по дням и покупкам." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource QuickActionButton}" Tag="Stats" Click="InsightNavigate_Click" Margin="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="#F0EFE5" VerticalAlignment="Top">
                                        <TextBlock Text="%" Foreground="{StaticResource AccentDarkBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Статистика" FontWeight="Bold" FontSize="17" />
                                        <TextBlock Text="Итоги по рецептам, продуктам и активности." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource PageCard}">
                    <StackPanel>
                        <TextBlock Text="Полезно сейчас" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Короткие подсказки по вашим продуктам, покупкам и рецептам." Style="{StaticResource MutedText}" Margin="0,0,0,14" />

                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource InsightCard}" Tag="Products" Click="InsightNavigate_Click">
                                <StackPanel>
                                    <TextBlock Text="!" Style="{StaticResource InsightIcon}" />
                                    <TextBlock Text="Скоро истекают продукты" FontSize="18" FontWeight="Bold" />
                                    <TextBlock x:Name="ExpirySummaryText" Style="{StaticResource MutedText}" Margin="0,6,0,8" />
                                    <ItemsControl x:Name="ExpiryItemsControl" />
                                    <TextBlock Text="Открыть продукты" Foreground="{StaticResource AccentDarkBrush}" FontWeight="Bold" Margin="0,10,0,0" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource InsightCard}" Tag="Search" Click="InsightNavigate_Click">
                                <StackPanel>
                                    <TextBlock Text="?" Style="{StaticResource InsightIcon}" />
                                    <TextBlock Text="Что можно приготовить сейчас" FontSize="18" FontWeight="Bold" />
                                    <TextBlock x:Name="CookNowSummaryText" Style="{StaticResource MutedText}" Margin="0,6,0,8" />
                                    <ItemsControl x:Name="CookNowItemsControl" />
                                    <TextBlock Text="Подобрать рецепты" Foreground="{StaticResource AccentDarkBrush}" FontWeight="Bold" Margin="0,10,0,0" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource InsightCard}" Tag="Shopping" Click="InsightNavigate_Click">
                                <StackPanel>
                                    <TextBlock Text="+" Style="{StaticResource InsightIcon}" />
                                    <TextBlock Text="Нужно докупить" FontSize="18" FontWeight="Bold" />
                                    <TextBlock x:Name="ShoppingSummaryText" Style="{StaticResource MutedText}" Margin="0,6,0,8" />
                                    <ItemsControl x:Name="ShoppingItemsControl" />
                                    <TextBlock Text="Перейти к покупкам" Foreground="{StaticResource AccentDarkBrush}" FontWeight="Bold" Margin="0,10,0,0" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource InsightCard}" Click="RecipeOfDayButton_Click">
                                <StackPanel>
                                    <TextBlock Text="★" Style="{StaticResource InsightIcon}" />
                                    <TextBlock Text="Рецепт дня" FontSize="18" FontWeight="Bold" />
                                    <TextBlock x:Name="RecipeOfDayTitleText" FontWeight="Bold" Margin="0,8,0,2" />
                                    <TextBlock x:Name="RecipeOfDaySummaryText" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="Открыть рецепт" Foreground="{StaticResource AccentDarkBrush}" FontWeight="Bold" Margin="0,10,0,0" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

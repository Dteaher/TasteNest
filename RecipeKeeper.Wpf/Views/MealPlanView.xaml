<UserControl x:Class="RecipeKeeper.Wpf.Views.MealPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RecipeKeeper.Wpf.Ui">
    <UserControl.Resources>
        <Style x:Key="MealPlanItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource AccentLightBrush}" />
                                <Setter TargetName="ItemRoot" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#E4F2EA" />
                                <Setter TargetName="ItemRoot" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource PageCard}" Margin="0,0,18,0">
            <ScrollViewer VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly"
                          ui:MouseWheelScroll.ForwardNestedWheel="True">
                <StackPanel>
                <TextBlock Text="План питания" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Соберите меню на неделю и сформируйте список покупок по выбранным блюдам."
                           Style="{StaticResource MutedText}"
                           Margin="0,0,0,18"
                           TextWrapping="Wrap" />

                <TextBlock Text="День" Style="{StaticResource LabelText}" />
                <ComboBox x:Name="DayComboBox"
                          Style="{StaticResource TasteNestComboBoxStyle}"
                          HorizontalContentAlignment="Left" />

                <TextBlock Text="Приём пищи" Style="{StaticResource LabelText}" />
                <ComboBox x:Name="MealComboBox"
                          Style="{StaticResource TasteNestComboBoxStyle}"
                          HorizontalContentAlignment="Left" />

                <TextBlock Text="Рецепт" Style="{StaticResource LabelText}" />
                <ComboBox x:Name="RecipeComboBox"
                          Style="{StaticResource TasteNestComboBoxStyle}"
                          DisplayMemberPath="Title"
                          TextSearch.TextPath="Title"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          StaysOpenOnEdit="True"
                          HorizontalContentAlignment="Left"
                          Tag="Начните вводить название рецепта" />

                <Button Content="Добавить в план"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch"
                        Margin="0,4,0,8"
                        Click="AddButton_Click" />

                <UniformGrid Columns="1" Margin="0,0,0,18">
                    <Button Content="Удалить выбранный приём"
                            Style="{StaticResource DangerButton}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,8"
                            Click="DeleteButton_Click" />
                    <Button Content="Сформировать покупки"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch"
                            Margin="0"
                            Click="ShoppingButton_Click" />
                </UniformGrid>

                <Border Background="{StaticResource SecondaryButtonBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="Как пользоваться" Style="{StaticResource SectionTitle}" FontSize="18" />
                        <TextBlock Text="Выберите день, приём пищи и рецепт. После добавления блюдо появится в плане справа."
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource PageCard}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="План на неделю" Style="{StaticResource PageTitle}" Margin="0,0,0,4" />
                        <TextBlock Text="Двойной клик по позиции открывает выбранный рецепт."
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Style="{StaticResource StatusBadge}"
                            VerticalAlignment="Top"
                            Margin="16,4,0,0">
                        <TextBlock Text="7 дней"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <ListBox x:Name="PlanListBox"
                         BorderThickness="0"
                         Background="Transparent"
                         ItemContainerStyle="{StaticResource MealPlanItemStyle}"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ui:MouseWheelScroll.ForwardNestedWheel="True"
                         MouseDoubleClick="PlanListBox_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FBFAF6"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="44"
                                            Height="44"
                                            Background="{StaticResource AccentLightBrush}"
                                            CornerRadius="22"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="📅"
                                                   FontSize="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="Запланированное блюдо"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Style="{StaticResource StatusBadge}"
                                            VerticalAlignment="Center"
                                            Margin="14,0,0,0">
                                        <TextBlock Text="Открыть"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>


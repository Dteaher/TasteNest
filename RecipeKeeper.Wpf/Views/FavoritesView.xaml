<UserControl x:Class="RecipeKeeper.Wpf.Views.FavoritesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RecipeKeeper.Wpf.Ui">
    <Border Style="{StaticResource PageCard}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Избранные рецепты" Style="{StaticResource PageTitle}" />
            <ScrollViewer VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly"
                          ui:MouseWheelScroll.ForwardNestedWheel="True">
                <StackPanel x:Name="RecipesPanel" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>

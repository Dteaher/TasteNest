<Window x:Class="RecipeKeeper.Wpf.Views.RecipeDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рецепт" Width="980" Height="720"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <Border Style="{StaticResource PageCard}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="310" Height="220" CornerRadius="8" Background="#EEEAE0" ClipToBounds="True">
                        <Image x:Name="RecipeImage" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="TitleTextBlock" Style="{StaticResource PageTitle}" />
                        <TextBlock x:Name="DescriptionTextBlock" Style="{StaticResource MutedText}" FontSize="16" />
                        <WrapPanel Margin="0,16,0,12">
                            <Border Background="#F2EFE7" CornerRadius="8" Padding="10,6" Margin="0,0,8,0"><TextBlock x:Name="CategoryTextBlock" /></Border>
                            <Border Background="#F2EFE7" CornerRadius="8" Padding="10,6" Margin="0,0,8,0"><TextBlock x:Name="TimeTextBlock" /></Border>
                            <Border Background="#F2EFE7" CornerRadius="8" Padding="10,6" Margin="0,0,8,0"><TextBlock x:Name="ServingsTextBlock" /></Border>
                            <Border Background="#F2EFE7" CornerRadius="8" Padding="10,6"><TextBlock x:Name="DifficultyTextBlock" /></Border>
                        </WrapPanel>
                        <WrapPanel>
                            <Button x:Name="FavoriteButton" Content="В избранное" Style="{StaticResource PrimaryButton}" Click="FavoriteButton_Click" />
                            <Button Content="Приготовлено" Click="CookButton_Click" />
                            <Button Content="Закрыть" Click="CloseButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource PageCard}" Margin="0,0,16,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Ингредиенты" Style="{StaticResource SectionTitle}" />
                        <ListBox x:Name="IngredientsListBox" />
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PageCard}">
                    <StackPanel>
                        <TextBlock Text="Шаги приготовления" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="InstructionsTextBlock" TextWrapping="Wrap" FontSize="16" LineHeight="24" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>

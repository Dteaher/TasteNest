<UserControl x:Class="RecipeKeeper.Wpf.Views.OperatorPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RecipeKeeper.Wpf.Ui">
    <ScrollViewer Style="{StaticResource PageScrollViewer}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource PageCard}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Панель пользователей" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Оператор обслуживает только обычных пользователей: смотрит активность, ведёт служебные заметки и блокирует аккаунты при нарушениях."
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#EEF4F7"
                            CornerRadius="14"
                            Padding="16,10"
                            VerticalAlignment="Center"
                            Margin="18,0,0,0">
                        <TextBlock Text="Operator · поддержка пользователей"
                                   Foreground="#285C73"
                                   FontWeight="Bold" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource PageCard}" Margin="0,0,16,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Пользователи" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="В таблице отображаются только аккаунты с ролью User."
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ComboBox x:Name="FilterComboBox"
                                          Width="230"
                                          SelectionChanged="FilterComboBox_SelectionChanged" />
                                <Button Content="Обновить"
                                        Click="RefreshButton_Click"
                                        Margin="8,0,0,0" />
                            </WrapPanel>
                        </Grid>

                        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,14">
                            <Border Style="{StaticResource SummaryCard}">
                                <StackPanel>
                                    <TextBlock Text="Всего User" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="TotalUsersText" FontSize="24" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SummaryCard}">
                                <StackPanel>
                                    <TextBlock Text="Активные" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="ActiveUsersText" FontSize="24" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SummaryCard}">
                                <StackPanel>
                                    <TextBlock Text="Заблокированы" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="BlockedUsersText" FontSize="24" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SummaryCard}">
                                <StackPanel>
                                    <TextBlock Text="Проблемные" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="ProblemUsersText" FontSize="24" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <DataGrid x:Name="UsersGrid"
                                  Style="{StaticResource StyledDataGrid}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MinHeight="500"
                                  SelectionChanged="UsersGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Email / логин" Binding="{Binding Email}" Width="2*" MinWidth="180" />
                                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="90" />
                                <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="120" />
                                <DataGridTextColumn Header="Регистрация" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy}}" Width="120" />
                                <DataGridTextColumn Header="Рецепты" Binding="{Binding RecipesCount}" Width="85" />
                                <DataGridTextColumn Header="Просмотры" Binding="{Binding ViewsCount}" Width="95" />
                                <DataGridTextColumn Header="Продукты" Binding="{Binding ProductsCount}" Width="85" />
                                <DataGridTextColumn Header="Последний вход" Binding="{Binding LastLoginAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PageCard}">
                    <StackPanel>
                        <TextBlock Text="Карточка пользователя" Style="{StaticResource PageTitle}" />
                        <Border Background="#F7F5ED" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="SelectedUserNameText"
                                           Text="Пользователь не выбран"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="SelectedUserDetailsText"
                                           Text="Выберите строку в таблице"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Причина блокировки" Style="{StaticResource LabelText}" />
                        <ComboBox x:Name="ReasonComboBox" />

                        <TextBlock Text="Комментарий к действию" Style="{StaticResource LabelText}" />
                        <TextBox x:Name="ActionCommentTextBox"
                                 Style="{StaticResource TasteNestMultilineTextBoxStyle}"
                                 MinHeight="76"
                                 Tag="Коротко опишите причину действия..." />

                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <Button x:Name="BlockButton"
                                    Content="Заблокировать"
                                    Style="{StaticResource DangerButton}"
                                    Click="BlockButton_Click" />
                            <Button x:Name="UnblockButton"
                                    Content="Разблокировать"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="UnblockButton_Click" />
                        </UniformGrid>

                        <TextBlock Text="Служебная заметка" Style="{StaticResource LabelText}" />
                        <TextBox x:Name="NoteTextBox"
                                 Style="{StaticResource TasteNestMultilineTextBoxStyle}"
                                 MinHeight="96"
                                 Tag="Заметка видна только оператору и администратору..." />
                        <Button x:Name="SaveNoteButton"
                                Content="Сохранить заметку"
                                Click="SaveNoteButton_Click" />

                        <Button x:Name="ViewProfileButton"
                                Content="Посмотреть профиль пользователя"
                                Click="ViewProfileButton_Click" />
                        <Button x:Name="LoadActivityButton"
                                Content="Посмотреть историю активности"
                                Click="LoadActivityButton_Click" />

                        <ListBox x:Name="ActivityListBox"
                                 MaxHeight="170"
                                 Margin="0,8,0,0"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                 ui:MouseWheelScroll.ForwardNestedWheel="True" />

                        <TextBlock x:Name="StatusTextBlock"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource PageCard}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Журнал действий" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="История блокировок и разблокировок пользователей операторами."
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <DataGrid x:Name="ActionLogGrid"
                              Style="{StaticResource StyledDataGrid}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MinHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Оператор" Binding="{Binding OperatorEmail}" Width="*" MinWidth="170" />
                            <DataGridTextColumn Header="Пользователь" Binding="{Binding TargetEmail}" Width="*" MinWidth="170" />
                            <DataGridTextColumn Header="Когда" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150" />
                            <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="*" MinWidth="150" />
                            <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="2*" MinWidth="220" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

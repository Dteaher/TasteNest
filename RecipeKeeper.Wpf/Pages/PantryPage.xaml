<Page x:Class="RecipeKeeper.Wpf.Pages.PantryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мои продукты"
      Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource PageCard}" Margin="0,0,14,0">
            <StackPanel>
                <TextBlock Text="Мои продукты" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Продукт" Style="{StaticResource LabelText}" />
                <TextBox x:Name="NameTextBox" />
                <TextBlock Text="Количество" Style="{StaticResource LabelText}" />
                <TextBox x:Name="QuantityTextBox" />
                <TextBlock Text="Срок годности" Style="{StaticResource LabelText}" />
                <DatePicker x:Name="ExpiresDatePicker" Margin="0,4,0,12" />
                <Button Content="Добавить" Style="{StaticResource PrimaryButton}" Click="AddButton_Click" />
                <Button Content="Удалить выбранный" Click="DeleteButton_Click" />
                <Button Content="Назад к рецептам" Click="BackButton_Click" />
            </StackPanel>
        </Border>

        <ListBox x:Name="ProductsListBox" Grid.Column="1" FontSize="16" />
    </Grid>
</Page>

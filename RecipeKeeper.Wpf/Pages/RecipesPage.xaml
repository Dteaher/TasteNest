<Page x:Class="RecipeKeeper.Wpf.Pages.RecipesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="TasteNest"
      Background="{StaticResource AppBackgroundBrush}">
    <Grid Style="{StaticResource PageShell}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="White"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="14,14,4,4"
                Margin="0,0,0,18">
            <Border.Effect>
                <DropShadowEffect Color="#D8CEC0" BlurRadius="16" ShadowDepth="2" Opacity="0.18" />
            </Border.Effect>
            <UniformGrid x:Name="NavigationPanel"
                         Rows="1"
                         SizeChanged="NavigationPanel_SizeChanged">
                <Button Style="{StaticResource NavigationButton}" Content="🔍  Поиск рецептов" Tag="Search" Click="NavigationButton_Click" />
                <Button Style="{StaticResource NavigationButton}" Content="🔥  Популярные" Tag="Popular" Click="NavigationButton_Click" />
                <Button Style="{StaticResource NavigationButton}" Content="🧺  Мои продукты" Tag="Products" Click="NavigationButton_Click" />
                <Button Style="{StaticResource NavigationButton}" Content="🛒  Список покупок" Tag="Shopping" Click="NavigationButton_Click" />
                <Button Style="{StaticResource NavigationButton}" Content="📅  План питания" Tag="MealPlan" Click="NavigationButton_Click" />
            </UniformGrid>
        </Border>

        <ContentControl x:Name="WorkspaceContent"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
    </Grid>
</Page>

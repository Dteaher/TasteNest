<Page x:Class="RecipeKeeper.Wpf.Pages.RecipeFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="clr-namespace:RecipeKeeper.Wpf.Ui"
      Title="Добавить рецепт"
      Background="{StaticResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly"
                  ui:MouseWheelScroll.ForwardNestedWheel="True">
        <Border Style="{StaticResource PageCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.ColumnSpan="2" Text="Добавить рецепт" Style="{StaticResource PageTitle}" />

                <TextBlock Grid.Row="1" Text="Название" Style="{StaticResource LabelText}" />
                <TextBox x:Name="TitleTextBox" Grid.Row="1" Grid.Column="1" />

                <TextBlock Grid.Row="2" Text="Категория" Style="{StaticResource LabelText}" />
                <ComboBox x:Name="CategoryComboBox" Grid.Row="2" Grid.Column="1" DisplayMemberPath="Name" />

                <TextBlock Grid.Row="3" Text="Описание" Style="{StaticResource LabelText}" />
                <TextBox x:Name="DescriptionTextBox" Grid.Row="3" Grid.Column="1" Height="74" TextWrapping="Wrap" AcceptsReturn="True" />

                <TextBlock Grid.Row="4" Text="Время / порции" Style="{StaticResource LabelText}" />
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="TimeTextBox" Width="120" Text="30" />
                    <TextBox x:Name="ServingsTextBox" Width="120" Text="2" />
                </StackPanel>

                <TextBlock Grid.Row="5" Text="Ингредиенты" Style="{StaticResource LabelText}" />
                <TextBox x:Name="IngredientsTextBox" Grid.Row="5" Grid.Column="1" Height="140" TextWrapping="Wrap" AcceptsReturn="True"
                         Text="курица - 300 г&#x0a;картофель - 3 шт." />

                <TextBlock Grid.Row="6" Text="Приготовление" Style="{StaticResource LabelText}" />
                <TextBox x:Name="InstructionsTextBox" Grid.Row="6" Grid.Column="1" Height="140" TextWrapping="Wrap" AcceptsReturn="True" />

                <UniformGrid Grid.Row="7" Grid.Column="1" Columns="2">
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" />
                    <Button Content="Назад" Style="{StaticResource SecondaryButton}" Click="BackButton_Click" />
                </UniformGrid>
            </Grid>
        </Border>
    </ScrollViewer>
</Page>
